  "faqCategories": [
    {
      "id": "common",
      "title": "常見問題",
      "items": [
        {
          "title": "課程退費",
          "content": [
            "購買課程後 7 日內，若未觀看超過 20% 的課程內容，可申請全額退費。",
            "超過 7 日或已觀看超過 20% 的課程內容，恕不接受退費申請。如有特殊情況，請聯繫客服。"
          ]
        },
        {
          "title": "課程影片無法播放",
          "content": [
            "1. 請確認您的網路連線是否正常。",
            "2. 嘗試重新整理頁面或清除瀏覽器快取。",
            "3. 建議使用 Chrome、Firefox 或 Safari 最新版本瀏覽器。",
            "4. 若問題持續，請聯繫線上客服。"
          ]
        }
      ]
    },
    {
      "id": "how-to-learn",
